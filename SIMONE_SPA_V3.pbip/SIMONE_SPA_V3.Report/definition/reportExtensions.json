{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "accounts",
      "measures": [
        {
          "name": "Activos",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Assets\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Pasivos",
          "dataType": "Double",
          "expression": "-CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Liabilities\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Patrimonio",
          "dataType": "Double",
          "expression": "-CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Equity\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Ingresos",
          "dataType": "Double",
          "expression": "-CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Income\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Costo de ventas",
          "dataType": "Double",
          "expression": "-CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Cost_x0020_of_x0020_Goods_x0020_Sold\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Gastos",
          "dataType": "Double",
          "expression": "-CALCULATE(SUM(accounts[netChange]), accounts[accountType] = \"Posting\", accounts[category] = \"Expense\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Resultado",
          "dataType": "Double",
          "expression": "[Ingresos] + [Costo de ventas] + [Gastos]",
          "formatString": "#,0,, \"MM$\"",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "accounts",
                "name": "Ingresos"
              },
              {
                "schema": "extension",
                "entity": "accounts",
                "name": "Costo de ventas"
              },
              {
                "schema": "extension",
                "entity": "accounts",
                "name": "Gastos"
              }
            ]
          }
        },
        {
          "name": "Saldo natural",
          "dataType": "Double",
          "expression": "CALCULATE(SUMX(accounts, IF(accounts[category] IN {\"Assets\", \"Expense\", \"Cost_x0020_of_x0020_Goods_x0020_Sold\"}, accounts[netChange], -accounts[netChange])), accounts[accountType] = \"Posting\")",
          "formatString": "#,0,, \"MM$\""
        },
        {
          "name": "Total cuentas",
          "dataType": "Double",
          "expression": "COUNTROWS(accounts)",
          "formatString": "#,0"
        },
        {
          "name": "Cuentas imputables",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(accounts), accounts[accountType] = \"Posting\")",
          "formatString": "#,0"
        },
        {
          "name": "Cuentas agrupación",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(accounts), accounts[accountType] = \"Total\")",
          "formatString": "#,0"
        },
        {
          "name": "Cuentas bloqueadas",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(accounts), accounts[blocked] = TRUE)",
          "formatString": "#,0"
        },
        {
          "name": "Cuentas registro directo",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(accounts), accounts[directPosting] = TRUE)",
          "formatString": "#,0"
        },
        {
          "name": "Saldo total proveedores",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(agedAccountsPayables[balanceDue]), agedAccountsPayables[vendorNumber] <> \"\")",
          "formatString": "$ #,0"
        },
        {
          "name": "Deuda vencida",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(agedAccountsPayables[balanceDue]) - SUM(agedAccountsPayables[currentAmount]), agedAccountsPayables[vendorNumber] <> \"\")",
          "formatString": "$ #,0"
        },
        {
          "name": "Deuda corriente",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(agedAccountsPayables[currentAmount]), agedAccountsPayables[vendorNumber] <> \"\")",
          "formatString": "$ #,0"
        },
        {
          "name": "Porcentaje vencido",
          "dataType": "Double",
          "expression": "DIVIDE([Deuda vencida], [Saldo total proveedores], 0)",
          "formatString": "0.0%",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "accounts",
                "name": "Deuda vencida"
              },
              {
                "schema": "extension",
                "entity": "accounts",
                "name": "Saldo total proveedores"
              }
            ]
          }
        },
        {
          "name": "Proveedores con saldo",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(agedAccountsPayables), agedAccountsPayables[vendorNumber] <> \"\", agedAccountsPayables[balanceDue] > 0)",
          "formatString": "#,0"
        },
        {
          "name": "Mayor contable proveedores",
          "dataType": "Double",
          "expression": "-1 * CALCULATE(SUM(accounts[netChange]), LEFT(accounts[number], 4) = \"2107\", accounts[accountType] = \"Posting\")",
          "formatString": "$ #,0"
        },
        {
          "name": "Facturas abiertas",
          "dataType": "Double",
          "expression": "CALCULATE(COUNTROWS(purchaseInvoices), purchaseInvoices[status] = \"Open\")",
          "formatString": "#,0"
        },
        {
          "name": "Monto facturas abiertas",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(purchaseInvoices[totalAmountIncludingTax]), purchaseInvoices[status] = \"Open\")",
          "formatString": "$ #,0"
        },
        {
          "name": "Deuda proveedor",
          "dataType": "Double",
          "expression": "SUM(agedAccountsPayables[balanceDue])",
          "formatString": "$ #,0"
        }
      ]
    }
  ]
}